{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Typecheck-only (tsc --noEmit); esbuild produces the runtime bundle,
    // so no outDir/rootDir constraints are needed even though typechecking
    // follows extensionless imports into workspace packages.
    "noEmit": true,
    // Bundler resolution: workspace imports are extensionless (`./roster`).
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
