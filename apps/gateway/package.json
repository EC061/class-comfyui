{
  "name": "@class-comfyui/gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs --log-level=warning",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@class-comfyui/auth": "workspace:*",
    "@class-comfyui/config": "workspace:*",
    "@class-comfyui/shared": "workspace:*",
    "express": "^4.19.2",
    "ioredis": "^5.3.2",
    "pg": "^8.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
