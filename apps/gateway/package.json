{
  "name": "@class-comfyui/gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@class-comfyui/auth": "workspace:*",
    "@class-comfyui/config": "workspace:*",
    "@class-comfyui/database": "workspace:*",
    "@class-comfyui/shared": "workspace:*",
    "express": "^4.19.2",
    "multer": "^2.1.0",
    "nodemailer": "^8.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
