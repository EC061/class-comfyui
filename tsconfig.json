{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@class-comfyui/config": ["./packages/config/src"],
      "@class-comfyui/shared": ["./packages/shared/src"],
      "@class-comfyui/auth": ["./packages/auth/src"],
      "@class-comfyui/database": ["./packages/database/src"]
    }
  },
  "include": ["packages/**/*", "tests/**/*"],
  "exclude": ["node_modules", "**/dist", "**/.next", "apps/**/*"]
}
