{
  "name": "class-comfyui",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @class-comfyui/web build",
    "build:gateway": "pnpm --filter @class-comfyui/gateway build",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/gateway/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @class-comfyui/database migrate",
    "db:seed": "pnpm --filter @class-comfyui/database seed",
    "test:e2e": "playwright test",
    "db:backup": "pnpm --filter @class-comfyui/database backup",
    "db:workers": "pnpm --filter @class-comfyui/database workers"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/smtp-server": "^3.5.13",
    "@types/ws": "^8.5.12",
    "eslint": "^9.12.0",
    "express": "^4.19.2",
    "mailparser": "^3.9.23",
    "prettier": "^3.3.3",
    "smtp-server": "^3.19.9",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
