# FRPC forwards HTTP here. TLS terminates outside this stack.
# Omit paths/query strings from logs because signup and exchange URLs carry secrets.
log_format lab '$remote_addr $server_name $request_method $status $request_time';
access_log /dev/stdout lab;
error_log /dev/stderr crit;
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server { listen 80 default_server; server_name _; return 444; }
server {
 listen 80;
 server_name ${PUBLIC_HOST};
 client_max_body_size 6m;
 location / {
  proxy_pass http://web:3000;
  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Host "";
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_read_timeout 300s;
 }
}
server {
 listen 80;
 server_name ${COMFY_HOST};
 client_max_body_size 100m;
 location / {
  proxy_pass http://gateway:8081;
  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Host "";
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_buffering off;
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;
 }
}
