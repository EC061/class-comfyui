# Two independent plain-HTTP listeners, one per public hostname.
# An EXTERNAL frpc (not part of this stack) opens one TCP tunnel per listener to
# an external frps; the reverse proxy in front of frps terminates TLS. Nothing
# here serves or terminates TLS, and routing is by PORT, not by Host header.
#   127.0.0.1:8080 -> tcp tunnel -> ${PUBLIC_HOST} (management/admin)
#   127.0.0.1:8090 -> tcp tunnel -> ${COMFY_HOST}  (gateway/workspace)
# Omit paths/query strings from logs because signup and exchange URLs carry secrets.
log_format lab '$remote_addr $server_port $request_method $status $request_time';
access_log /dev/stdout lab;
error_log /dev/stderr crit;
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
 listen 8080;
 server_name _;
 client_max_body_size 6m;
 location / {
  proxy_pass http://web:3000;
  proxy_http_version 1.1;
  # Normalize Host to the canonical authority. Over a TCP tunnel the Host that
  # arrives depends on the remote reverse proxy, so it is rewritten rather than
  # trusted. Applications build every link from PUBLIC_URL, never from headers.
  proxy_set_header Host ${PUBLIC_HOST};
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Host "";
  # Public scheme is https; TLS terminates on the remote reverse proxy. No
  # application code trusts this header, it is set only for correctness.
  proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_read_timeout 300s;
 }
}
server {
 listen 8090;
 server_name _;
 client_max_body_size 100m;
 location / {
  proxy_pass http://gateway:8081;
  proxy_http_version 1.1;
  proxy_set_header Host ${COMFY_HOST};
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Host "";
  proxy_set_header X-Forwarded-Proto ${COMFY_SCHEME};
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_buffering off;
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;
 }
}
